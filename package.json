    "@next/mdx": "^16.2.4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "fs": "^0.0.1-security",
    "gray-matter": "^4.0.3",
    "next": "^16.2.4",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "reading-time": "^1.4.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
